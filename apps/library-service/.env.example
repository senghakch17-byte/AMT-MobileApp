# ==============================================================================
# Application Configuration
# ==============================================================================
PROJECT_NAME="Library Service Backend Core"
ENVIRONMENT=development                # Options: development, staging, production
DEBUG=true                             # Enable detailed logging and debug tools

# ==============================================================================
# API & Network Routing
# ==============================================================================
API_V1_STR=/api/v1
ROOT_PATH=/library                     # Route prefix the gateway strips before forwarding

# ==============================================================================
# Database Configuration (MongoDB)
# ==============================================================================
MONGODB_URI=mongodb://localhost:27017/final_project
MONGODB_DB_NAME=final_project

# ==============================================================================
# Security & Authentication
# ==============================================================================
# Must match the secret used by the auth service that issues the tokens.
# Generate a secure secret key using: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256

# ==============================================================================
# Room Booking Rules
# ==============================================================================
REQUIRE_BOOKING_APPROVAL=true         # true: bookings start "pending" until an admin approves
                                      # false: bookings are approved immediately if the slot is free
MIN_BOOKING_MINUTES=30
MAX_BOOKING_HOURS=4
