# ==========================================
# 🚀 PROJECT CONFIGURATION: Event-service Backend Core
# ==========================================

# Core Application Settings
PROJECT_NAME=Event-service Backend Core
DEBUG=True
ENVIRONMENT=development


# ==========================================
# 🗄️ DATABASE & CACHE
# ==========================================

# MongoDB Connection
MONGODB_URI=
MONGODB_DB_NAME=final_project

# Redis Connection
REDIS_URL=redis://localhost:6379


# ==========================================
# 🔐 SECURITY & AUTHENTICATION
# ==========================================

JWT_SECRET=
JWT_ALGORITHM=HS256


# ==========================================
# 📂 FILE STORAGE & UPLOADS
# ==========================================

UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000/events  # gateway URL + route prefix
MAX_IMAGE_MB=5
MAX_IMAGES_PER_EVENT=10


# ==========================================
# ⚡ PERFORMANCE & RATE LIMITING
# ==========================================

# Cache Time-To-Live (TTL) Settings
CACHE_TTL_LIST=30        # seconds
CACHE_TTL_DETAIL=120     # seconds

# API Rate Limiting
RATE_LIMIT_READ=60/minute