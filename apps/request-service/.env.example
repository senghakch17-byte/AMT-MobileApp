# ==============================================================================
# Application Configuration
# ==============================================================================
PROJECT_NAME="FastAPI Backend Core"
ENVIRONMENT=development                # Options: development, staging, production
DEBUG=true                             # Enable detailed logging and debug tools

# ==============================================================================
# API & Network Routing
# ==============================================================================
API_V1_STR=/api/v1

# ==============================================================================
# Database Configuration (MongoDB)
# ==============================================================================
# Replace placeholders with your Atlas cluster credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=final_project

# ==============================================================================
# Security & Authentication
# ==============================================================================
# MUST match the JWT_SECRET configured in auth-service for signature verification
JWT_SECRET=your_auth_service_shared_jwt_secret_here
JWT_ALGORITHM=HS256