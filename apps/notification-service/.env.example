PORT=8005
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/final_project
JWT_SECRET=<the-same-secret-used-by-login-service>
JWT_ALGORITHM=HS256
REDIS_URL=redis://redis:6379
REDIS_STREAM_KEY=notification:events
REDIS_CONSUMER_GROUP=notification-service
# Set a distinct stable name only when running more than one consumer replica.
REDIS_CONSUMER_NAME=notification-worker
INTERNAL_API_KEY=<long-random-secret-shared-with-event-producers>
