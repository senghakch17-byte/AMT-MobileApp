# ==============================================================================
# Application Configuration
# ==============================================================================
PROJECT_NAME="Event Service Backend Core"
ENVIRONMENT=development                # Options: development, staging, production
DEBUG=true                             # Enable detailed logging and debug tools

# ==============================================================================
# API & Network Routing
# ==============================================================================
API_V1_STR=/api/v1
PUBLIC_BASE_URL=http://localhost:4000/event    # Gateway URL + route prefix

# ==============================================================================
# Database Configuration (MongoDB)
# ==============================================================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/final_project
MONGODB_DB_NAME=final_project

# ==============================================================================
# Security & Authentication
# ==============================================================================
# Generate a secure secret key using: openssl rand -hex 32
JWT_SECRET=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256

# ==============================================================================
# Storage & Media Uploads
# ==============================================================================
UPLOAD_DIR=uploads
MAX_IMAGE_MB=5                        # Maximum file size per image in megabytes
MAX_IMAGES_PER_EVENT=10               # Maximum allowed images per event listing