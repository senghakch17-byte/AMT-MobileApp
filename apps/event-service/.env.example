# ==============================================================================
# Application Configuration
# ==============================================================================
PROJECT_NAME="Event Service Backend Core"
ENVIRONMENT=development                # Options: development, staging, production
DEBUG=true                             # Enable detailed logging and debug tools

# ==============================================================================
# API & Network Routing
# ==============================================================================
API_V1_STR=/api/v1
PUBLIC_BASE_URL=http://localhost:4000/event    # Gateway URL + route prefix

# ==============================================================================
# Database Configuration (MongoDB)
# ==============================================================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/final_project
MONGODB_DB_NAME=final_project

# Redis Connection
REDIS_URL=redis://localhost:6379


# ==========================================
# 🔐 SECURITY & AUTHENTICATION
# ==========================================

JWT_SECRET=
JWT_ALGORITHM=HS256


# ==========================================
# 📂 FILE STORAGE & UPLOADS
# ==========================================

UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000/events  # gateway URL + route prefix
MAX_IMAGE_MB=5
MAX_IMAGES_PER_EVENT=10


# ==========================================
# ⚡ PERFORMANCE & RATE LIMITING
# ==========================================

# Cache Time-To-Live (TTL) Settings
CACHE_TTL_LIST=30        # seconds
CACHE_TTL_DETAIL=120     # seconds

# API Rate Limiting
RATE_LIMIT_READ=60/minute

# Notification producer; use http://localhost:8005 outside Docker.
NOTIFICATION_SERVICE_URL=http://localhost:8005
INTERNAL_API_KEY=<same-secret-as-notification-service>