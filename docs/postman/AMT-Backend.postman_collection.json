{
  "info": {
    "_postman_id": "f0d57f14-df7c-4c11-a8c5-amt-backend-api",
    "name": "AMT Backend API",
    "description": "Gateway collection for the AMT microservices. Set gatewayUrl, register/login, then run protected endpoints. Login requests store userToken or adminToken automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{userToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "userEmail",
      "value": "user@example.com"
    },
    {
      "key": "userPassword",
      "value": "ChangeMe123!"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": "ChangeMeAdmin123!"
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "leaveRequestId",
      "value": ""
    },
    {
      "key": "eventId",
      "value": ""
    },
    {
      "key": "preScholarshipAcademicYear",
      "value": "2026-2027"
    },
    {
      "key": "attendanceId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Gateway health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/health",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "02 - Registration and login",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "url": "{{gatewayUrl}}/register/register",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Example User\",\n  \"emailid\": \"{{userEmail}}\",\n  \"pass\": \"{{userPassword}}\",\n  \"mobile\": \"+85512345678\",\n  \"role\": \"user\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Public. Creates a standard user; duplicate email returns 400."
          }
        },
        {
          "name": "Login user (save userToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code === 200) { pm.environment.set('userToken', pm.response.json().token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{gatewayUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailid\": \"{{userEmail}}\",\n  \"pass\": \"{{userPassword}}\",\n  \"role\": \"user\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Public. Requires emailid, pass, and role; JWT expires in one hour."
          }
        },
        {
          "name": "Register admin (only when authorized)",
          "request": {
            "method": "POST",
            "url": "{{gatewayUrl}}/register/register",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Example Admin\",\n  \"emailid\": \"{{adminEmail}}\",\n  \"pass\": \"{{adminPassword}}\",\n  \"mobile\": \"+85512345679\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The current registration API accepts a role field. Use admin registration only in a controlled test database; do not expose admin self-registration in production."
          }
        },
        {
          "name": "Login admin (save adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login succeeded', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code === 200) { pm.environment.set('adminToken', pm.response.json().token); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{gatewayUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailid\": \"{{adminEmail}}\",\n  \"pass\": \"{{adminPassword}}\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates an admin bearer token when the admin account exists."
          }
        }
      ]
    },
    {
      "name": "03 - Leave requests (user token)",
      "item": [
        {
          "name": "Request service health",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/request/health"
          }
        },
        {
          "name": "Create leave request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.environment.set('leaveRequestId', pm.response.json().id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{gatewayUrl}}/request/leave-requests",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"leave_type\": \"sick\",\n  \"start_date\": \"2026-11-02\",\n  \"end_date\": \"2026-11-03\",\n  \"reason\": \"Medical appointment and recovery time\",\n  \"attachment_urls\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List my leave requests",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/request/leave-requests?skip=0&limit=20"
          }
        },
        {
          "name": "Get leave request by ID",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/request/leave-requests/{{leaveRequestId}}"
          }
        },
        {
          "name": "Update pending leave request",
          "request": {
            "method": "PATCH",
            "url": "{{gatewayUrl}}/request/leave-requests/{{leaveRequestId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Updated reason for this leave request\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Cancel pending leave request",
          "request": {
            "method": "PATCH",
            "url": "{{gatewayUrl}}/request/leave-requests/{{leaveRequestId}}/cancel"
          }
        },
        {
          "name": "Create pre-scholarship registration",
          "request": {
            "method": "POST",
            "url": "{{gatewayUrl}}/request/pre-scholarship-registrations",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scholarship_type\": \"need_based\",\n  \"academic_year\": \"{{preScholarshipAcademicYear}}\",\n  \"full_name\": \"Example Student\",\n  \"date_of_birth\": \"2010-04-15\",\n  \"gender\": \"female\",\n  \"phone\": \"+85512345678\",\n  \"address\": \"123 Example Street, Phnom Penh\",\n  \"school_name\": \"Example High School\",\n  \"grade_level\": \"Grade 10\",\n  \"guardian_name\": \"Example Guardian\",\n  \"guardian_phone\": \"+85512345679\",\n  \"guardian_relationship\": \"parent\",\n  \"monthly_family_income\": 300,\n  \"number_of_dependents\": 4,\n  \"academic_average\": 85,\n  \"achievements\": [],\n  \"statement\": \"Our family needs support so I can continue my education.\",\n  \"document_urls\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Use scholarship_type need_based with monthly_family_income, or merit with academic_average. Active duplicate academic_year returns 409."
          }
        },
        {
          "name": "List my pre-scholarship registrations",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/request/pre-scholarship-registrations?skip=0&limit=20"
          }
        }
      ]
    },
    {
      "name": "04 - Events (admin for writes)",
      "item": [
        {
          "name": "Create event (admin)",
          "request": {
            "method": "POST",
            "url": "{{gatewayUrl}}/event/events",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Community Information Session\",\n  \"description\": \"An information session for students and families.\",\n  \"category\": \"announcement\",\n  \"location\": \"Phnom Penh\",\n  \"start_at\": \"2026-11-15T09:00:00+07:00\",\n  \"end_at\": \"2026-11-15T11:00:00+07:00\",\n  \"status\": \"draft\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "script": {
                "exec": [
                  "if (pm.response.code === 201) { pm.environment.set('eventId', pm.response.json().id); }"
                ],
                "type": "text/javascript"
              },
              "listen": "test"
            }
          ]
        },
        {
          "name": "List events (user or admin)",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/event/events?skip=0&limit=20"
          }
        },
        {
          "name": "Get event by ID (user sees published only)",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/event/events/{{eventId}}"
          }
        },
        {
          "name": "Update event (admin)",
          "request": {
            "method": "PATCH",
            "url": "{{gatewayUrl}}/event/events/{{eventId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"published\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete event (admin)",
          "request": {
            "method": "DELETE",
            "url": "{{gatewayUrl}}/event/events/{{eventId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "05 - Attendance",
      "item": [
        {
          "name": "Attendance health",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/attendance/health"
          }
        },
        {
          "name": "Check in (save attendanceId)",
          "request": {
            "method": "POST",
            "url": "{{gatewayUrl}}/attendance/check-in"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Check-in created', function () { pm.expect(pm.response.code).to.eql(201); });",
                  "if (pm.response.code === 201) { pm.environment.set('attendanceId', pm.response.json()._id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Check out",
          "request": {
            "method": "POST",
            "url": "{{gatewayUrl}}/attendance/check-out"
          }
        },
        {
          "name": "List my attendance",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/attendance/me"
          }
        },
        {
          "name": "List all attendance (admin)",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/attendance/?from=2026-01-01&to=2026-12-31",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Update attendance (admin)",
          "request": {
            "method": "PATCH",
            "url": "{{gatewayUrl}}/attendance/{{attendanceId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"present\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "06 - Notifications",
      "item": [
        {
          "name": "Notification health",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/notification/health"
          }
        },
        {
          "name": "List notifications",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/notification/api/v1/notifications?skip=0&limit=20"
          }
        },
        {
          "name": "Get unread count",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/notification/api/v1/notifications/unread-count"
          }
        },
        {
          "name": "Get notification by ID",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/notification/api/v1/notifications/{{notificationId}}"
          }
        },
        {
          "name": "Mark all notifications read",
          "request": {
            "method": "PATCH",
            "url": "{{gatewayUrl}}/notification/api/v1/notifications/read-all"
          }
        },
        {
          "name": "Mark notification read",
          "request": {
            "method": "PATCH",
            "url": "{{gatewayUrl}}/notification/api/v1/notifications/{{notificationId}}/read"
          }
        },
        {
          "name": "Delete notification",
          "request": {
            "method": "DELETE",
            "url": "{{gatewayUrl}}/notification/api/v1/notifications/{{notificationId}}"
          }
        },
        {
          "name": "Get notification preferences",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/notification/api/v1/notification-preferences/me"
          }
        },
        {
          "name": "Update notification preferences",
          "request": {
            "method": "PATCH",
            "url": "{{gatewayUrl}}/notification/api/v1/notification-preferences/me",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inAppEnabled\": true,\n  \"mutedTypes\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
