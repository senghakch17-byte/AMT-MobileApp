# ==============================================================================
# Application Configuration
# ==============================================================================
PROJECT_NAME="Member Service Backend Core"
ENVIRONMENT=development                # Options: development, staging, production
DEBUG=true                             # Enable detailed logging and debug tools

# ==============================================================================
# API & Network Routing
# ==============================================================================
API_V1_STR=/api/v1
ROOT_PATH=                 # Route prefix the gateway strips before forwarding
PUBLIC_BASE_URL=http://localhost:4000/members   # Gateway URL + route prefix (used for download links)

# ==============================================================================
# Database Configuration (MongoDB)
# ==============================================================================
# Replace <db_password> with your actual database user password when creating your local .env file
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/final_project
MONGODB_DB_NAME=final_project

# ==============================================================================
# Security & Authentication
# ==============================================================================
# Must match the secret used by the auth service that issues the tokens.
# Generate a secure secret key using: openssl rand -hex 32
JWT_SECRET=<the-same-secret-used-by-login-service>
JWT_ALGORITHM=HS256

# ==============================================================================
# Document Storage
# ==============================================================================
UPLOAD_DIR=uploads                     # Private: files are served only through authenticated endpoints
MAX_DOCUMENT_MB=10                     # Maximum size per uploaded document in megabytes